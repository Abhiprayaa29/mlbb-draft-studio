# ---------------------------------------------------------------------------
# Integrasi data eksternal (GRID) — SALIN ke .env lalu isi.
# .env TIDAK boleh di-commit (lihat .gitignore). Jangan pernah menaruh secret
# nyata di file ini, di repository, di UI, atau di payload Socket.IO.
# ---------------------------------------------------------------------------

# Aktifkan integrasi (default false = sumber data MANUAL)
GRID_ENABLED=false

# Kredensial & endpoint — HANYA dibaca di sisi server, tidak pernah dikirim ke
# browser/OBS. Kosongkan bila belum memiliki akses.
GRID_API_KEY=
GRID_GRAPHQL_URL=
GRID_WS_URL=

# Identifikasi pertandingan (diisi setelah discovery schema tersedia)
GRID_COMPETITION_ID=
GRID_SERIES_ID=

# Provider saat start: manual | grid | fixture   (default manual)
GRID_DATA_SOURCE=manual

# Fixture yang diputar provider fixture (lihat server/grid/fixtures/)
GRID_FIXTURE=draft
# Jeda antar event fixture (0 = serentak / deterministik untuk uji)
GRID_FIXTURE_INTERVAL_MS=300

# Mode otomasi: monitor | semi | auto  (default monitor — TIDAK mengubah state)
AUTOMATION_MODE=monitor
# Gerbang kedua untuk mode auto; auto tidak pernah jalan tanpa ini = true
AUTOMATION_ENABLED=false

# ---------------------------------------------------------------------------
# OBS WebSocket OCR (opsional) — capture gameplay otomatis dari OBS Studio.
# Password hanya dibaca server; TIDAK PERNAH dikirim ke browser/state/log.
# ---------------------------------------------------------------------------
OCR_OBS_WS_URL=ws://127.0.0.1:4455
OCR_OBS_WS_PASSWORD=
# Nama source di OBS (kosong = pilih lewat API GET /api/ocr/obs/sources)
OCR_OBS_SOURCE_NAME=
# Jeda antar frame (ms). 1000 = 1 fps.
OCR_OBS_INTERVAL_MS=1000
# Auto-start capture saat server boot (default false — operator harus start manual)
OCR_OBS_AUTO_START=false

# ---------------------------------------------------------------------------
# ScoreSight file bridge (opsional) — baca file output ScoreSight.
# Hanya 9 file yang diizinkan: Home/Away Score, Gold, Lord, Turret, Time.
# NOTE: nama file Away Turret di ScoreSight salah eja "Away Turet.txt" —
# bridge mengikuti nama aktual tersebut.
#
# SCORESIGHT_DIR harus path yang ter-BACA di mesin backend (Linux/CachyOS).
# Path Windows (C:\...) TIDAK valid di Linux — gunakan shared folder:
#   Windows: Properties folder → Sharing → Advanced Sharing → share sebagai
#            \\WINDOWS-HOST\Scoresight
#   Linux  : sudo mount -t cifs //WINDOWS-HOST/Scoresight /mnt/scoresight \
#              -o guest,ro,vers=3.0
#   .env   : SCORESIGHT_DIR=/mnt/scoresight
# Buka akses READ-ONLY (ro) — backend tidak perlu menulis.
# ---------------------------------------------------------------------------
SCORESIGHT_ENABLED=false
SCORESIGHT_DIR=
SCORESIGHT_POLL_INTERVAL_MS=500
# Home → Blue atau Red. Kosong = MAPPING_REQUIRED (patch ditahan).
SCORESIGHT_HOME_SIDE=blue
# Mode pembacaan satuan gold dari file ScoreSight:
#   raw       (default) — integer/file suffix-k dibaca apa adanya (satuan gold asli)
#   thousands — integer kecil (<1000) dianggap satuan ribuan → ×1000
SCORESIGHT_GOLD_MODE=raw
