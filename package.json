{
  "name": "mlbb-draft-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MLBB Draft Studio - sistem draft pick & scoreboard untuk overlay OBS",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "data:fetch": "node scripts/fetch-hero-data.js",
    "data:import": "node scripts/import-database.js",
    "data:validate": "node scripts/validate-data.js",
    "data:battle-spells": "node scripts/import-battle-spells.js",
    "data:all": "npm run data:fetch && npm run data:import && npm run data:validate",
    "test": "node scripts/e2e-test.js",
    "test:e2e": "node scripts/e2e-test.js",
    "test:server": "node scripts/server-test.js",
    "test:ocr": "node scripts/ocr-test.js",
    "test:all": "npm run test:server && npm run test:ocr && npm run test:e2e"
  },
  "dependencies": {
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "obs-websocket-js": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
